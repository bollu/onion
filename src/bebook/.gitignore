build
.bebook_store
.bewiki_store

# Local runtime config; the packaged one is generated by create_packages.sh
bebook.cfg
bewiki.cfg

# Python bytecode from tools/
__pycache__/
*.pyc

# Vendored SQLite amalgamation, fetched by tools/fetch_sqlite.sh (like the HarfBuzz submodule).
third-party/sqlite/

# Vendored zstd decoder amalgamation, fetched by tools/fetch_zstd.sh.
third-party/zstd/

# Wiktextract (kaikki.org) Italian dump, fetched by tools/fetch_kaikki.sh. ~761MB build
# input for build_lexicon.py.
third-party/kaikki/

# The dictionary DB ships compressed (resources/italian.sqlite.xz, ~16MB, committed). The
# raw ~80MB .sqlite is unpacked from it at build time (see the Makefile) and never committed.
resources/italian.sqlite

# Offline Wikipedia archives, fetched by tools/fetch_zim.sh. 836MB for the nopic
# flavour, 107MB for mini -- never committed.
resources/wiki/
